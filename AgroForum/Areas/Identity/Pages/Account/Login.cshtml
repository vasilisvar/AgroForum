@page
@model LoginModel
@{
    ViewData["Title"] = "Sign in";
    ViewData["BodyClass"] = "auth-body";
}

<section class="auth-page">
    <div class="container auth-container">
        <div class="auth-shell">
            <partial name="_AuthStoryPanel" />

            <div class="auth-form-panel">
                <div class="auth-form-wrap">
                    <div class="auth-form-heading">
                        <span class="eyebrow">Welcome back</span>
                        <h1>Sign in to your account</h1>
                        <p>Continue the conversations that help agricultural communities grow.</p>
                    </div>

                    <form id="account" method="post" asp-route-returnUrl="@Model.ReturnUrl" class="auth-form">
                        <div asp-validation-summary="ModelOnly" class="alert alert-danger" role="alert"></div>

                        <div class="form-floating">
                            <input asp-for="Input.Email" class="form-control" autocomplete="username" aria-required="true" placeholder="name@example.com" />
                            <label asp-for="Input.Email">Email address</label>
                            <span asp-validation-for="Input.Email" class="text-danger"></span>
                        </div>

                        <div class="form-floating">
                            <input asp-for="Input.Password" class="form-control" autocomplete="current-password" aria-required="true" placeholder="Password" />
                            <label asp-for="Input.Password">Password</label>
                            <span asp-validation-for="Input.Password" class="text-danger"></span>
                        </div>

                        <div class="auth-form-options">
                            <label asp-for="Input.RememberMe" class="form-check-label">
                                <input class="form-check-input" asp-for="Input.RememberMe" />
                                Keep me signed in
                            </label>
                            <a asp-page="./ForgotPassword">Forgot password?</a>
                        </div>

                        <button id="login-submit" type="submit" class="btn btn-agro btn-lg auth-submit">Sign in</button>

                        <p class="auth-switch">
                            New to AgroForum?
                            <a asp-page="./Register" asp-route-returnUrl="@Model.ReturnUrl">Create an account</a>
                        </p>
                    </form>

                    @if (Model.ExternalLogins?.Count > 0)
                    {
                        <div class="external-login">
                            <span>Or continue with</span>
                            <form asp-page="./ExternalLogin" asp-route-returnUrl="@Model.ReturnUrl" method="post">
                                @foreach (var provider in Model.ExternalLogins)
                                {
                                    <button type="submit" class="btn btn-sign-in" name="provider" value="@provider.Name">@provider.DisplayName</button>
                                }
                            </form>
                        </div>
                    }
                </div>
            </div>
        </div>
    </div>
</section>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}

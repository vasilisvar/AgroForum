@model ForumIndexViewModel

@{
    ViewData["Title"] = "Forum";
    var activeTagName = Model.AvailableTags
        .FirstOrDefault(tag => tag.Slug == Model.Tag || tag.Name == Model.Tag)?.Name;
    var sortLabel = Model.Sort switch
    {
        "likes" => "Most liked",
        "comments" => "Most discussed",
        _ => "Newest first"
    };
    var currentReturnUrl = $"{Context.Request.Path}{Context.Request.QueryString}";
}

<section class="forum-shell py-5">
    <div class="container">
        @if (TempData["ForumMessage"] is string message)
        {
            <div class="alert alert-success">@message</div>
        }

        <section class="forum-welcome-banner mb-4" aria-labelledby="forum-page-title">
            <div class="forum-welcome-copy">
                <p class="forum-welcome-kicker mb-2">
                    <span aria-hidden="true"></span>
                    Farmer-led knowledge
                </p>
                <h1 id="forum-page-title" class="display-6 fw-bold mb-2">Community discussions</h1>
                <p class="forum-welcome-description mb-4">
                    Ask practical questions, share field experience, and collect reliable input from the community.
                </p>

                @if (User.Identity?.IsAuthenticated == true)
                {
                    <a class="btn btn-success" asp-action="Create">Start a discussion</a>
                }
                else
                {
                    <a class="btn btn-outline-success" asp-area="Identity" asp-page="/Account/Login">Log in to post</a>
                }
            </div>

            <div class="forum-welcome-art">
                <img src="~/images/illustrations/farm-girl.svg"
                     asp-append-version="true"
                     alt="Farmer tending young crops" />
            </div>
        </section>

        <div class="forum-discovery-layout">
            <aside class="forum-filter-sidebar" aria-label="Forum search and filters">
                <partial name="_SearchFilters" model="Model" />
            </aside>

            <div class="forum-results">
                <div class="forum-results-toolbar">
                    <div>
                        <p class="forum-results-count mb-1">
                            @Model.TotalResults @(Model.TotalResults == 1 ? "discussion" : "discussions") found
                        </p>
                        <h2 class="h4 fw-bold mb-0">
                            @if (!string.IsNullOrWhiteSpace(Model.Search))
                            {
                                <span>Results for &ldquo;@Model.Search&rdquo;</span>
                            }
                            else if (!string.IsNullOrWhiteSpace(activeTagName))
                            {
                                <span>@activeTagName discussions</span>
                            }
                            else
                            {
                                <span>All community discussions</span>
                            }
                        </h2>
                    </div>
                    <span class="forum-sort-badge">@sortLabel</span>
                </div>

                @if (Model.Posts.Any())
                {
                    <div class="forum-post-list">
                        @foreach (var post in Model.Posts)
                        {
                            <article class="forum-card forum-post-card">
                        <div class="d-flex flex-wrap justify-content-between gap-3">
                            <div>
                                <div class="d-flex flex-wrap gap-2 mb-2">
                                    @foreach (var tag in post.Tags)
                                    {
                                        <a class="forum-tag text-decoration-none"
                                           asp-action="Index"
                                           asp-route-search="@Model.Search"
                                           asp-route-tag="@tag"
                                           asp-route-sort="@Model.Sort">@tag</a>
                                    }
                                </div>

                                <h2 class="h4 fw-bold mb-2">
                                    <a class="forum-post-title"
                                       asp-action="Details"
                                       asp-route-id="@post.Id">@post.Title</a>
                                </h2>

                                @if (post.IsPinned)
                                {
                                    <span class="badge text-bg-success me-1">Pinned</span>
                                }
                            </div>

                            @if (post.IsLocked)
                            {
                                <span class="badge text-bg-secondary align-self-start">Locked</span>
                            }
                        </div>

                        <p class="forum-meta mb-2">
                            Posted by @post.AuthorName
                            @if (post.IsAuthorModerator)
                            {
                                <span class="moderator-badge">Moderator</span>
                            }
                            on @post.CreatedAt.ToLocalTime().ToString("dd MMM yyyy, HH:mm")
                        </p>

                        @if (!string.IsNullOrWhiteSpace(post.ImagePath))
                        {
                            <a class="forum-post-image-link" asp-action="Details" asp-route-id="@post.Id" aria-label="Read @post.Title">
                                <img class="forum-post-image forum-post-image-card"
                                     src="@post.ImagePath"
                                     alt="Image attached to @post.Title"
                                     loading="lazy" />
                            </a>
                        }

                        <p class="forum-post-preview text-muted mb-3">@post.Preview</p>

                        <div class="d-flex flex-wrap align-items-center gap-3 forum-meta">
                            <a class="btn btn-success btn-sm"
                               asp-action="Details"
                               asp-route-id="@post.Id">Read full post</a>
                            @if (post.CommentCount > 0)
                            {
                                <a class="btn btn-outline-success btn-sm"
                                   asp-action="Details"
                                   asp-route-id="@post.Id"
                                   asp-fragment="comments">See all comments (@post.CommentCount)</a>
                            }
                            else
                            {
                                <a class="btn btn-outline-success btn-sm"
                                   asp-action="Details"
                                   asp-route-id="@post.Id"
                                   asp-fragment="add-comment">Be the first to comment</a>
                            }
                            @if (User.Identity?.IsAuthenticated == true)
                            {
                                <form asp-action="ToggleLike" method="post" class="engagement-form">
                                    <input type="hidden" name="postId" value="@post.Id" />
                                    <input type="hidden" name="returnUrl" value="@currentReturnUrl" />
                                    <button type="submit"
                                            class="engagement-button @(post.IsLikedByCurrentUser ? "is-active" : null)"
                                            aria-pressed="@post.IsLikedByCurrentUser.ToString().ToLowerInvariant()">
                                        <span aria-hidden="true">&#9829;</span>
                                        <span>@(post.IsLikedByCurrentUser ? "Liked" : "Like")</span>
                                        <strong>@post.LikeCount</strong>
                                    </button>
                                </form>
                                <form asp-action="ToggleFavorite" method="post" class="engagement-form">
                                    <input type="hidden" name="postId" value="@post.Id" />
                                    <input type="hidden" name="returnUrl" value="@currentReturnUrl" />
                                    <button type="submit"
                                            class="engagement-button @(post.IsFavoritedByCurrentUser ? "is-active" : null)"
                                            aria-pressed="@post.IsFavoritedByCurrentUser.ToString().ToLowerInvariant()">
                                        <span aria-hidden="true">&#9733;</span>
                                        <span>@(post.IsFavoritedByCurrentUser ? "Saved" : "Save")</span>
                                        <strong>@post.FavoriteCount</strong>
                                    </button>
                                </form>
                            }
                            else
                            {
                                <a class="engagement-button"
                                   asp-area="Identity"
                                   asp-page="/Account/Login"
                                   asp-route-returnUrl="@currentReturnUrl"
                                   title="Log in to like this discussion">
                                    <span aria-hidden="true">&#9829;</span>
                                    <span>Like</span>
                                    <strong>@post.LikeCount</strong>
                                </a>
                                <a class="engagement-button"
                                   asp-area="Identity"
                                   asp-page="/Account/Login"
                                   asp-route-returnUrl="@currentReturnUrl"
                                   title="Log in to save this discussion">
                                    <span aria-hidden="true">&#9733;</span>
                                    <span>Save</span>
                                    <strong>@post.FavoriteCount</strong>
                                </a>
                            }
                            @if (post.IsAnonymous)
                            {
                                <span>Anonymous post</span>
                            }
                        </div>
                            </article>
                        }
                    </div>

                    @if (Model.TotalPages > 1)
                    {
                        var startPage = Math.Max(1, Model.CurrentPage - 2);
                        var endPage = Math.Min(Model.TotalPages, Model.CurrentPage + 2);

                        <nav class="forum-pagination" aria-label="Forum result pages">
                            <ul class="pagination justify-content-center mb-0">
                                <li class="page-item @(!Model.HasPreviousPage ? "disabled" : null)">
                                    <a class="page-link"
                                       asp-action="Index"
                                       asp-route-search="@Model.Search"
                                       asp-route-tag="@Model.Tag"
                                       asp-route-sort="@Model.Sort"
                                       asp-route-page="@(Model.CurrentPage - 1)"
                                       aria-label="Previous page">Previous</a>
                                </li>

                                @if (startPage > 1)
                                {
                                    <li class="page-item">
                                        <a class="page-link" asp-action="Index" asp-route-search="@Model.Search" asp-route-tag="@Model.Tag" asp-route-sort="@Model.Sort" asp-route-page="1">1</a>
                                    </li>
                                    @if (startPage > 2)
                                    {
                                        <li class="page-item disabled"><span class="page-link">&hellip;</span></li>
                                    }
                                }

                                @for (var pageNumber = startPage; pageNumber <= endPage; pageNumber++)
                                {
                                    <li class="page-item @(pageNumber == Model.CurrentPage ? "active" : null)">
                                        <a class="page-link"
                                           asp-action="Index"
                                           asp-route-search="@Model.Search"
                                           asp-route-tag="@Model.Tag"
                                           asp-route-sort="@Model.Sort"
                                           asp-route-page="@pageNumber">@pageNumber</a>
                                    </li>
                                }

                                @if (endPage < Model.TotalPages)
                                {
                                    @if (endPage < Model.TotalPages - 1)
                                    {
                                        <li class="page-item disabled"><span class="page-link">&hellip;</span></li>
                                    }
                                    <li class="page-item">
                                        <a class="page-link" asp-action="Index" asp-route-search="@Model.Search" asp-route-tag="@Model.Tag" asp-route-sort="@Model.Sort" asp-route-page="@Model.TotalPages">@Model.TotalPages</a>
                                    </li>
                                }

                                <li class="page-item @(!Model.HasNextPage ? "disabled" : null)">
                                    <a class="page-link"
                                       asp-action="Index"
                                       asp-route-search="@Model.Search"
                                       asp-route-tag="@Model.Tag"
                                       asp-route-sort="@Model.Sort"
                                       asp-route-page="@(Model.CurrentPage + 1)"
                                       aria-label="Next page">Next</a>
                                </li>
                            </ul>
                        </nav>
                    }
                }
                else
                {
                    <div class="forum-card forum-empty-state text-center py-5">
                        <img class="forum-empty-illustration"
                             src="~/images/illustrations/farming.svg"
                             asp-append-version="true"
                             alt="Crop growing under the sun" />
                        <h2 class="h4 fw-bold">No discussions found</h2>
                        <p class="text-muted mb-3">Try broader keywords or clear one of the current filters.</p>
                        <a class="btn btn-outline-success" asp-action="Index">Reset discovery</a>
                    </div>
                }
            </div>
        </div>
    </div>
</section>

@using Microsoft.AspNetCore.Identity
@using AgroForum.Models
@inject SignInManager<ApplicationUser> SignInManager
@inject UserManager<ApplicationUser> UserManager

<ul class="navbar-nav account-nav">
@if (SignInManager.IsSignedIn(User))
{
    <li class="nav-item">
        <a class="nav-link account-link" asp-area="Identity" asp-page="/Account/Manage/Index" title="Manage account">
            <span class="account-avatar">@((User.Identity?.Name ?? "A")[..1].ToUpperInvariant())</span>
            <span class="account-name">@User.Identity?.Name</span>
        </a>
    </li>
    <li class="nav-item">
        <form asp-area="Identity" asp-page="/Account/Logout" asp-route-returnUrl="@Url.Action("Index", "Home", new { area = "" })">
            <button type="submit" class="btn btn-sign-in">Sign out</button>
        </form>
    </li>
}
else
{
    <li class="nav-item">
        <a class="btn btn-sign-in" asp-area="Identity" asp-page="/Account/Login">Sign in</a>
    </li>
    <li class="nav-item">
        <a class="btn btn-agro nav-join" asp-area="Identity" asp-page="/Account/Register">Join community</a>
    </li>
}
</ul>
